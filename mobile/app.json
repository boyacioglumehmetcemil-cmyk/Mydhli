{
  "expo": {
    "name": "myDHLi PNG",
    "slug": "mydhli-png",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mydhli",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "description": "DHL Global Forwarding · Papua New Guinea",
    "primaryColor": "#FFCC00",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dhlpng.gf.preview"
    },
    "android": {
      "package": "com.dhlpng.gf.preview",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFCC00"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "myDHLi",
      "shortName": "myDHLi",
      "lang": "en",
      "scope": "/m/",
      "startUrl": "/m/",
      "themeColor": "#FFCC00",
      "backgroundColor": "#FFCC00",
      "display": "standalone",
      "orientation": "portrait",
      "description": "DHL Global Forwarding · Papua New Guinea"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFCC00"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/m"
    }
  }
}
